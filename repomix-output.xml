<file path=".github/workflows/ios-build.yml">
name: iOS Build IPA

permissions:
  contents: write

on:
  workflow_dispatch:
  push:
    tags:
      - 'v*'

jobs:
  build-android:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Install pnpm
        uses: pnpm/action-setup@v3
        with:
          version: 9

      - name: Install dependencies
        run: pnpm install

      - name: Build Web
        run: pnpm run build

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Build Android APK
        run: |
          npx cap sync android
          cd android && bash gradlew assembleRelease

      - name: Rename APK
        run: |
          VERSION=$(node -p "require('./package.json').version")
          FILENAME="FacturaPro VE App ${VERSION}.apk"
          APK_PATH=$(find android/app/build/outputs/apk/release -name "*.apk" | head -n 1)
          mv "$APK_PATH" "$FILENAME"
          echo "APK_FILENAME=$FILENAME" >> $GITHUB_ENV

      - name: Upload Android Artifact
        uses: actions/upload-artifact@v4
        with:
          name: android-release
          path: "*.apk"

  build-ios:
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Install pnpm
        uses: pnpm/action-setup@v3
        with:
          version: 9

      - name: Install dependencies
        run: pnpm install

      - name: Build Web
        run: pnpm run build

      - name: Build iOS App
        run: |
          npx cap sync ios
          cd ios/App
          # Build unsigned app bundle
          xcodebuild -workspace App.xcworkspace -scheme App -configuration Release -sdk iphoneos CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO -derivedDataPath build
          
          # Create IPA structure
          mkdir -p ../../Payload
          cp -r build/Build/Products/Release-iphoneos/App.app ../../Payload/
          cd ../..
          zip -r "FacturaPro VE App.ipa" Payload

      - name: Rename IPA
        run: |
          VERSION=$(node -p "require('./package.json').version")
          FILENAME="FacturaPro VE App ${VERSION}.ipa"
          mv "FacturaPro VE App.ipa" "$FILENAME"
          echo "IPA_FILENAME=$FILENAME" >> $GITHUB_ENV

      - name: Upload iOS Artifact
        uses: actions/upload-artifact@v4
        with:
          name: ios-release
          path: "*.ipa"

  create-release:
    needs: [build-android, build-ios]
    runs-on: ubuntu-latest
    if: startsWith(github.ref, 'refs/tags/v') || github.event_name == 'workflow_dispatch'
    steps:
      - uses: actions/checkout@v4
      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22
      - name: Download All Artifacts
        uses: actions/download-artifact@v4

      - name: Get Version
        id: get_version
        run: echo "VERSION=$(node -p "require('./package.json').version")" >> $GITHUB_OUTPUT

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          name: "FacturaPro VE App v${{ steps.get_version.outputs.VERSION }}"
          tag_name: "v${{ steps.get_version.outputs.VERSION }}"
          files: |
            android-release/*.apk
            ios-release/*.ipa
          body: |
            Lanzamiento FacturaPro VE App v${{ steps.get_version.outputs.VERSION }}
            
            Este archivo .ipa está listo para ser firmado e instalado mediante Sideloadly.
          generate_release_notes: true
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
</file>

</files>
