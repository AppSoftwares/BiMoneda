    @Query("SELECT SUM(totalBs) FROM invoices WHERE status = 'PAID'")
    fun getTotalEarnedBs(): Flow<Double?>

    @Insert(onConflict = OnConflictStrategy.REPLACE)
    suspend fun insertInvoice(invoice: InvoiceEntity): Long

